{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hisfuture",
  "version": "0.1.0",
  "identifier": "com.terce.hisfuture",
  "build": {  
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hisfuture",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/HISFuture.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["his"],
        "name": "HIS Future Project",
        "description": "Proyecto H.I.S. Future",
        "role": "Editor"
      }
    ]
  }
}
