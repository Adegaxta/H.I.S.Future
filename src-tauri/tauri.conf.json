{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hisfuture",
  "version": "0.1.3",
  "identifier": "com.terce.hisfuture",
  "build": {  
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "H.I.S.",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["his"],
        "name": "HIS Future Project",
        "description": "Proyecto H.I.S. Future",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkyNjQ0MkMxNUI4MkNBQUEKUldTcXlvSmJ3VUpra3NDV3lnR2xCbHluL0l5R0xxc0lPUFRKMlp4NlRmRGdLTDFBTGFVallWSjYK",
      "endpoints": [
        "https://github.com/Adegaxta/H.I.S.Future/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
