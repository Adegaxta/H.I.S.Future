{
  "name": "hisfuture",
  "private": true,
  "version": "0.6.3",
  "type": "module",
  "scripts": {
    "generate:material-symbols": "node scripts/generate-material-symbol-catalog.mjs",
    "update:icon-search-metadata": "node scripts/update-icon-search-metadata.mjs",
    "lexicon:update": "node scripts/lexicon/update-lexicon.mjs",
    "lexicon:import:kaikki": "node scripts/lexicon/import-kaikki.mjs",
    "lexicon:import:wordnet": "node scripts/lexicon/import-open-english-wordnet.mjs",
    "test:lexicon": "node tests/lexicon.test.mjs",
    "benchmark:lexicon": "node tests/lexicon-benchmark.mjs",
    "benchmark:context-engine": "node tests/context-engine-benchmark.mjs",
    "benchmark:gemitav": "node tests/gemitav-v0-benchmark.mjs && node tests/gemitav-v0.1-benchmark.mjs",
    "test:gemitav-v0.1": "node tests/gemitav-v0.1.test.mjs",
    "test:language-understanding": "node tests/language-understanding-v1.test.mjs",
    "benchmark:language-understanding": "node tests/language-understanding-v1-benchmark.mjs",
    "benchmark:lexicon:sqlite": "node scripts/lexicon/benchmark-sqlite.mjs",
    "predev": "npm run generate:material-symbols",
    "dev": "vite",
