{
  "name": "hisfuture",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "generate:material-symbols": "node scripts/generate-material-symbol-catalog.mjs",
    "update:icon-search-metadata": "node scripts/update-icon-search-metadata.mjs",
    "predev": "npm run generate:material-symbols",
    "dev": "vite",
    "prebuild": "npm run generate:material-symbols",
    "build": "tsc && vite build",
    "test:graph": "node tests/graph-projection.test.mjs && node tests/graph-runtime.test.mjs && node tests/graph-renderer.test.mjs && node tests/graph-simulation.test.mjs",
    "test:graph:stress": "node tests/graph-stress.mjs",
    "test:node-registry": "node tests/node-registry.test.mjs",
    "test:unsplash": "node tests/unsplash.test.mjs",
    "pretest:visuals": "npm run generate:material-symbols",
    "test:visuals": "node tests/node-visuals.test.mjs",
    "test:windows-identity": "node tests/windows-identity.test.mjs",
    "test:nodal": "node tests/node-registry.test.mjs && node tests/project-node.test.mjs && node tests/nodal.test.mjs && npm run test:graph && node tests/import-invariants.test.mjs && node tests/ux-context.test.mjs && node tests/qol-0.1.2.test.mjs && npm run test:editor",
    "test:i18n": "node tests/i18n.test.mjs",
    "test:lifecycle": "node tests/lifecycle.test.mjs",
    "test:editor": "node tests/editor-compatibility.test.mjs",
    "test:performance": "npm run build && node tests/performance-budget.test.mjs",
    "test:presence": "node tests/presence.test.mjs",
    "test:release": "pwsh -NoProfile -File tests/release-script.test.ps1",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/noto-color-emoji": "^5.3.1",
    "@material-symbols/font-400": "^0.47.2",
    "@sableclient/twemoji-font": "^1.0.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "emojibase-data": "^17.0.0",
    "lucide-react": "^1.45.0",
    "pdfjs-dist": "6.3.289",
    "pixi.js": "^8.20.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "lucide-static": "^1.45.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
